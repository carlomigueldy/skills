{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestra run record",
  "type": "object",
  "required": ["schemaVersion", "runId", "goal", "host", "capabilities", "tierResolution", "scheduler", "delegationDepth", "isolation", "reopenCount", "chain", "lanes"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
    "goal": {"type": "string", "minLength": 1},
    "host": {"enum": ["claude-cowork", "codex-cli", "opencode", "grok-build", "claude-code"]},
    "capabilities": {
      "type": "object",
      "required": ["parallelSubagents", "childDepth", "isolatedContext"],
      "properties": {
        "parallelSubagents": {"type": "boolean"},
        "childDepth": {"type": "integer", "minimum": 0, "maximum": 2},
        "isolatedContext": {"type": "boolean"}
      }
    },
    "tierResolution": {
      "type": "object",
      "required": ["deep", "standard", "fast"],
      "properties": {
        "deep": {"enum": ["high", "medium", "low"]},
        "standard": {"enum": ["high", "medium", "low"]},
        "fast": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": false
    },
    "scheduler": {"enum": ["parallel-subagents", "sequential-role-pass", "self-execute"]},
    "delegationDepth": {"type": "integer", "minimum": 0, "maximum": 2},
    "isolation": {"enum": ["intact", "degraded"]},
    "verdictCap": {"const": "unverified"},
    "reopenCount": {
      "type": "object",
      "propertyNames": {"pattern": "^0[1-6]-(cover|debug|design|document|fan-out|harden|implement|migrate|perf|plan|refactor|research|review|ship|spike|triage|upgrade|verify)/[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}
    },
    "chain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["chainPosition", "workflow"],
        "properties": {
          "chainPosition": {"type": "integer", "minimum": 1, "maximum": 6},
          "workflow": {"$ref": "#/$defs/workflow"},
          "status": {"enum": ["planned", "in_progress", "complete", "blocked"]}
        },
        "additionalProperties": false
      }
    },
    "adversaryEscalations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["laneId", "trigger", "resolvedTier"],
        "properties": {
          "laneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "workflow": {"$ref": "#/$defs/workflow"},
          "chainPosition": {"type": "integer", "minimum": 1, "maximum": 6},
          "trigger": {"enum": ["security-surface", "cross-boundary-change", "prover-disagreement", "empty-findings-over-threshold"]},
          "resolvedTier": {"const": "deep"}
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["laneId", "resolvedTier", "wave"],
        "properties": {
          "laneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "workflow": {"$ref": "#/$defs/workflow"},
          "chainPosition": {"type": "integer", "minimum": 1, "maximum": 6},
          "resolvedTier": {"enum": ["deep", "standard", "fast"]},
          "wave": {"type": "integer", "minimum": 0},
          "workerId": {"type": "string", "minLength": 1},
          "hoistedFrom": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "depth": {"type": "integer", "minimum": 0, "maximum": 2}
        }
      }
    },
    "gateRun": {
      "type": "object",
      "required": ["ranAfterIntegration", "result", "evidence"],
      "properties": {
        "ranAfterIntegration": {"const": true},
        "result": {"enum": ["pass", "fail"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "blastRadius", "rollback", "answer"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "blastRadius": {"type": "string", "minLength": 1},
          "rollback": {"type": "string", "minLength": 1},
          "answer": {"enum": ["approved", "declined", "pending"]}
        }
      }
    }
  },
  "allOf": [
    {"not": {"required": ["deeperDelegationJustification"]}},
    {"if": {"properties": {"isolation": {"const": "degraded"}}, "required": ["isolation"]},
     "then": {"required": ["verdictCap"]}},
    {"if": {"properties": {"scheduler": {"const": "self-execute"}}, "required": ["scheduler"]},
     "then": {"properties": {"capabilities": {"properties": {"childDepth": {"const": 0}}, "required": ["childDepth"]}}}},
    {"if": {"properties": {"scheduler": {"const": "parallel-subagents"}}, "required": ["scheduler"]},
     "then": {"properties": {"capabilities": {"properties": {"parallelSubagents": {"const": true}, "childDepth": {"minimum": 1}}, "required": ["parallelSubagents", "childDepth"]}}}},
    {"if": {"required": ["chain"]},
     "then": {"properties": {"lanes": {"items": {"required": ["laneId", "resolvedTier", "wave", "workflow", "chainPosition"]}}}}}
  ],
  "$defs": {
    "workflow": {
      "enum": ["plan", "design", "spike", "fan-out", "implement", "verify", "review", "debug", "triage", "research", "refactor", "migrate", "upgrade", "harden", "perf", "cover", "document", "ship"]
    }
  },
  "additionalProperties": true
}
