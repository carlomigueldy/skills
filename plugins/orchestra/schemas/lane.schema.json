{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestra lane dispatch record",
  "type": "object",
  "required": ["schemaVersion", "host", "capabilities", "dispatch", "lanePlan", "normalizedLaneResults"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "host": {"enum": ["claude-cowork", "codex-cli", "opencode", "grok-build", "claude-code"]},
    "capabilities": {
      "type": "object",
      "required": ["parallelSubagents", "childDepth", "isolatedContext"],
      "properties": {
        "parallelSubagents": {"type": "boolean"},
        "childDepth": {"type": "integer", "minimum": 0, "maximum": 2},
        "isolatedContext": {"type": "boolean"}
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["scheduler", "isolation", "waves"],
      "properties": {
        "scheduler": {"enum": ["parallel-subagents", "sequential-role-pass", "self-execute"]},
        "isolation": {"enum": ["intact", "degraded"]},
        "verdictCap": {"const": "unverified"},
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["wave", "laneIds"],
            "properties": {
              "wave": {"type": "integer", "minimum": 0},
              "laneIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"}}
            }
          }
        },
        "hoisted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["laneId", "hoistedFrom"],
            "properties": {
              "laneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
              "hoistedFrom": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"isolation": {"const": "degraded"}}, "required": ["isolation"]},
         "then": {"required": ["verdictCap"]}}
      ]
    },
    "lanePlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "tier", "mode", "depth", "dependsOn", "ownedPaths", "inputs", "deliverable", "acceptance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "role": {"enum": ["scout", "analyst", "architect", "builder", "prover", "adversary", "judge", "mechanic"]},
          "tier": {"enum": ["deep", "standard", "fast"]},
          "mode": {"enum": ["read_only", "write", "execute"]},
          "depth": {"type": "integer", "minimum": 1, "maximum": 2},
          "parentLaneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"}},
          "ownedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9._-]+)*/?(?![\\s\\S])"}},
          "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "deliverable": {"type": "string", "minLength": 1},
          "acceptance": {"type": "string", "minLength": 1},
          "escalationTrigger": {"enum": ["security-surface", "cross-boundary-change", "prover-disagreement", "empty-findings-over-threshold"]}
        },
        "allOf": [
          {"if": {"properties": {"mode": {"enum": ["read_only", "execute"]}}, "required": ["mode"]},
           "then": {"properties": {"ownedPaths": {"maxItems": 0}}}},
          {"if": {"properties": {"mode": {"const": "write"}}, "required": ["mode"]},
           "then": {"properties": {"ownedPaths": {"minItems": 1}}}},
          {"if": {"properties": {"depth": {"const": 2}}, "required": ["depth"]},
           "then": {"required": ["parentLaneId"], "properties": {"role": {"const": "mechanic"}}}},
          {"if": {"properties": {"role": {"const": "mechanic"}}, "required": ["role"]},
           "then": {"required": ["parentLaneId"], "properties": {"depth": {"const": 2}}}},
          {"if": {"allOf": [{"properties": {"role": {"const": "adversary"}}, "required": ["role"]}, {"properties": {"tier": {"const": "deep"}}, "required": ["tier"]}]},
           "then": {"required": ["escalationTrigger"]}},
          {"if": {"properties": {"role": {"enum": ["scout", "analyst", "architect", "adversary", "judge"]}}, "required": ["role"]},
           "then": {"properties": {"mode": {"const": "read_only"}}}},
          {"if": {"properties": {"role": {"enum": ["builder", "mechanic"]}}, "required": ["role"]},
           "then": {"properties": {"mode": {"const": "write"}}}},
          {"if": {"properties": {"role": {"const": "prover"}}, "required": ["role"]},
           "then": {"properties": {"mode": {"const": "execute"}}}}
        ]
      }
    },
    "normalizedLaneResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["laneId", "status", "deliverables", "evidence", "findingIds"],
        "properties": {
          "laneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"},
          "status": {"enum": ["pending", "in_progress", "blocked", "partial", "verified", "stale"]},
          "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "findingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "escalation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
           "then": {"properties": {"deliverables": {"minItems": 1}, "evidence": {"minItems": 1}}}},
          {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
           "then": {"required": ["escalation"]}}
        ]
      }
    }
  },
  "allOf": [
    {"not": {"required": ["deeperDelegationJustification"]}},
    {"if": {"properties": {"dispatch": {"properties": {"scheduler": {"const": "self-execute"}}, "required": ["scheduler"]}}, "required": ["dispatch"]},
     "then": {"properties": {"capabilities": {"properties": {"childDepth": {"const": 0}}, "required": ["childDepth"]}}}}
  ],
  "additionalProperties": true
}
