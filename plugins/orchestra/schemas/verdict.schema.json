{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestra verdict",
  "type": "object",
  "required": ["id", "verdict", "rationale", "unresolvedHighOrCritical", "isolation", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^V-[0-9]{3,}$"},
    "verdict": {"enum": ["approve", "request_changes", "unverified"]},
    "rationale": {"type": "string", "minLength": 1},
    "unresolvedHighOrCritical": {"type": "integer", "minimum": 0},
    "isolation": {"enum": ["intact", "degraded"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^F-[0-9]{3,}$"}},
    "decidedByLaneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "gateRunEvidence": {"type": "string", "minLength": 1},
    "humanException": {
      "type": "object",
      "required": ["party", "reason"],
      "properties": {
        "party": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "recordedAt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "approve"}}, "required": ["verdict"]},
     "then": {"anyOf": [
       {"properties": {"unresolvedHighOrCritical": {"const": 0}}, "required": ["unresolvedHighOrCritical"]},
       {"required": ["humanException"]}
     ]}},
    {"if": {"properties": {"verdict": {"const": "approve"}}, "required": ["verdict"]},
     "then": {"required": ["gateRunEvidence"]}},
    {"if": {"properties": {"isolation": {"const": "degraded"}}, "required": ["isolation"]},
     "then": {"properties": {"verdict": {"enum": ["request_changes", "unverified"]}}}}
  ]
}
